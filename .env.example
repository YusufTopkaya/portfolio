# Google Analytics Measurement ID (GA4)
# Get this from your Google Analytics account (Admin → Data Streams → Web)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-JGL6HGW4QM"

# Google Tag Manager ID
# Get this from your Google Tag Manager account
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXXX"

# Microsoft Clarity Project ID
# Get this from your Microsoft Clarity account (Dashboard → Settings)
NEXT_PUBLIC_CLARITY_PROJECT_ID="twndbrkd0b"

# Site URL for metadata (Dokploy production)
NEXT_PUBLIC_SITE_URL=https://www.yusuftopkaya.com

# Easter egg: typing this sequence on the site opens one of the two URLs at random
NEXT_PUBLIC_KEY_SEQUENCE=yusuf
NEXT_PUBLIC_CGR=http://türksigara.net
NEXT_PUBLIC_BR=https://turkbira.net

# Compression and Performance Settings
ANALYZE=false
NODE_ENV=production

# Twingo Racer highscore service (server-only, NEVER NEXT_PUBLIC_*)
# Secret used to HMAC-sign single-use score-submit tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Runtime env var only (Dokploy: NOT a build arg). Without it the leaderboard
# API answers 503 and the game simply hides the leaderboard UI.
HIGHSCORE_SALT=""
# Optional: override where scores are stored (default ./data/highscores.json).
# In Docker mount a volume at /app/data or scores reset on every redeploy.
# HIGHSCORE_FILE=/app/data/highscores.json
